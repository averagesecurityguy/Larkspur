{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/averagesecurityguy/larkspur/schemas/agent_plan.json",
    "title": "AgentPlan",
    "description": "Larkspur agent plan schema",
    "type": "object",
    "properties": {
        "objective": {
            "type": "string",
            "description": "The objective that will be met by working through each of the user_goals."
        },
        "goals": {
            "type": "array",
            "description": "A list of goals needed to accomplish the objective.",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "goal": {
                        "type": "string",
                        "description": "A single goal a client is trying to achieve."
                    },
                    "agent": {
                        "type": "string",
                        "description": "The name of the agent that should be used to meet this goal."
                    },
                    "prompt": {
                        "type": "string",
                        "description": "The prompt explaining what the agent should do to meet the goal."
                    },
                },
                "required": ["goal", "agent", "prompt"],
                "additionalProperties": false
            },
        }
    },
    "required": ["objective", "goals"],
    "additionalProperties": false    
}
